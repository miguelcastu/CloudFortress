# Terraform local data, state and plans
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
tfplan
tfplan.*
crash.log
crash.*.log
.terraform.tfstate.lock.info

# Local inputs and overrides may contain secrets
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Local credentials and environment variables
.env
.env.*
!.env.example
credentials.json
application_default_credentials.json
service-account*.json
*-credentials.json
*.pem
*.key

# Editor and operating system files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
